{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],

  // Renovate merges itself: merges done with the workflow GITHUB_TOKEN don't trigger the push build on main
  "automerge": true,
  "automergeStrategy": "squash",

  // major updates should be reviewed, so major ones are labeled and not auto-merged
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
      "automerge": false,
    },
  ],

  // GeoServer version isn't a package dependency, just a string in
  // versions.json. Tracked via geoserver/geoserver GitHub releases
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["\"geoserver_version\":\\s*\"(?<currentValue>3\\.[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "geoserver/geoserver",
      "extractVersionTemplate": "^(?<version>3\\..*)$",
    },
  ],
}
